  },
  "trace_model_chosen_saved": {
    "channel": "trace",
    "type": "event",
    "payload": {
      "type": "model.chosen",
      "turn_id": "turn-1",
      "category": "chat",
      "provider": "other",
      "model": "s",
      "mode": "default",
      "reason": "saved default",
      "span_id": "turn-1",
      "source": "turn"
    }
  },
  "trace_model_chosen_ignored": {
    "channel": "trace",
    "type": "event",
    "payload": {
      "type": "model.chosen",
      "turn_id": "turn-1",
      "category": "reasoning",
      "provider": "fake",
      "model": "m",
      "mode": "default",
      "reason": "saved default ignored: other/s isn't installed",
      "span_id": "turn-1",
      "source": "turn"
    }
  },
  "turn_with_load_all_frames": [
    {
      "channel": "chat",
      "type": "turn.start",
      "payload": {
        "turn_id": "turn-1",
        "think": false,
        "rethink_of": null
      }
    },
    {
      "channel": "trace",
      "type": "event",
      "payload": {
        "type": "model.chosen",
        "turn_id": "turn-1",
        "category": "code",
