  },
  "turn_end_no_saved_default": {
    "channel": "chat",
    "type": "turn.end",
    "payload": {
      "text": "primaryanswer",
      "model": {
        "provider": "fake",
        "model": "m"
      },
      "category": "chat",
      "think": false,
      "thinking_ms": null,
      "think_unsupported_reason": null,
      "rethink_of": null
